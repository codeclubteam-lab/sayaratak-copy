{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "start": "bun run .output/server/index.mjs",
    "lint": "eslint && bun scripts/check-rules.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:states": "bun run build && STATES=1 playwright test states",
    "test:journeys": "bun run build && playwright test -c playwright.journeys.config.ts",
    "size": "bun scripts/check-size.ts",
    "i18n:check": "bun scripts/check-i18n.ts",
    "i18n:literals": "bun scripts/check-literals.ts",
    "seo:check": "bun scripts/check-seo.ts",
    "audit:design": "bun scripts/audit-design.ts",
    "contrast": "bun scripts/contrast.ts",
    "shots": "bun scripts/shots.ts",
    "banners": "bun scripts/make-banners.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@faker-js/faker": "^10.6.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "@sayaratak/shared": "workspace:*",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.2.5",
    "better-auth": "1.7.10",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.4.2",
    "input-otp": "^1.5.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.51.0",
    "nanoid": "^6.0.1",
    "nitro": "^3.0.260903-beta",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-leaflet": "^5.0.0",
    "react-resizable-panels": "^4.14.2",
    "recharts": "3.8.0",
    "shadcn": "^4.21.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.167.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.2",
    "vite": "^8",
    "vitest": "^5.0.3"
  }
}
