API_BASE_URL=http://localhost:4000
VITE_API_BASE_URL=http://localhost:4000
VITE_DEMO=true
VITE_FEATURE_OTP=false
VITE_FEATURE_FACEBOOK=false
APP_ORIGIN=http://localhost:3000
# Extra image hosts for the Content-Security-Policy img-src, space separated (src/lib/csp.ts).
# https://res.cloudinary.com is already allowed by default alongside the API origin.
IMAGE_ORIGINS=https://res.cloudinary.com
# Opt in only on Render; never expose the dedicated signing key through VITE_ variables.
CLIENT_IP_MODE=socket
PROXY_CLIENT_IP_SECRET=
