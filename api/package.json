{
  "name": "api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome format .",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:seed": "bun scripts/seed.ts",
    "db:bootstrap": "bun scripts/bootstrap.ts",
    "bootstrap:data": "bun scripts/bootstrap-data.make.ts",
    "create-admin": "bun scripts/create-admin.ts",
    "db:backup": "bun scripts/db-backup.ts",
    "db:restore": "bun scripts/db-restore.ts",
    "job": "bun scripts/job.ts",
    "openapi": "bun scripts/openapi.ts",
    "parity": "bun test parity"
  },
  "dependencies": {
    "@sayaratak/shared": "workspace:*",
    "better-auth": "1.7.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "nodemailer": "10.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "^1.4.4",
    "@types/nodemailer": "8.0.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3"
  }
}
