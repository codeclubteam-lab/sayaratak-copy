# Copy to .env and fill in. Blank values count as not set.
# Variables under "Services" are optional in development and test and
# required when APP_ENV=production.

NODE_ENV=development
APP_ENV=development
PORT=4000
DATABASE_URL=postgres://sayaratak:sayaratak@localhost:5432/sayaratak
TEST_DATABASE_URL=postgres://sayaratak:sayaratak@localhost:5434/sayaratak
# Production only: the database owner, used by db:migrate and pg_restore. When set, DATABASE_URL
# must be a different user (sayaratak_app): db:migrate creates it with the password in DATABASE_URL
# and gives it read and write on rows, nothing else. Blank in development: one user does all.
MIGRATE_DATABASE_URL=
DB_POOL_MAX=10
WEB_ORIGIN=http://localhost:3000
# Comma-separated IPs or CIDRs of the reverse proxy
TRUSTED_PROXIES=
# At least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000
# Lowest app build (semver, e.g. 1.4.0) that may call the API; older ones get 426. Blank means no gate
MIN_APP_VERSION_IOS=
MIN_APP_VERSION_ANDROID=
# Put in front of pg_dump and pg_restore; the tool must be the server's major version (18).
# Development example: docker run --rm -i --network host postgres:18.3-alpine3.23
# Leave blank in production, the image has the right client.
PG_CLIENT_CMD=
# debug, info, warn, error
LOG_LEVEL=info
# One log line per request (method, route, status, ms, user id); false to silence.
LOG_REQUESTS=true
# Platform admin endpoint (create, update, delete the one admin). Off while either is blank.
# Key: at least 32 characters, openssl rand -base64 32. The inbox receives the confirm codes.
ADMIN_SECRET_KEY=
ADMIN_RECOVERY_EMAIL=

# Services
COOKIE_DOMAIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
CLOUDINARY_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Firebase service account JSON on one line
FCM_SERVICE_ACCOUNT=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_APP_BUNDLE_ID=
